   "id": "b3a19701",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from sklearn.preprocessing import LabelEncoder\n",
    "\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import (\n",
    "    Input,\n",
    "    Conv2D,\n",
    "    MaxPooling2D,\n",
    "    BatchNormalization,\n",
    "    Dropout,\n",
    "    Flatten,\n",
    "    Dense,\n",
    "    GlobalAveragePooling2D\n",
    ")\n",
    "\n",
    "data = np.load(\"audio_features.npz\")\n",
    "\n",
    "X_train = data[\"X_train\"]\n",
    "X_test = data[\"X_test\"]\n",
    "\n",
    "y_train = data[\"y_train\"]\n",
    "y_test = data[\"y_test\"]\n",
    "\n",
    "groups = data[\"groups\"]\n",
    "train_idx = data[\"train_idx\"]\n",
    "test_idx = data[\"test_idx\"]\n",
    "\n",
    "label_encoder = LabelEncoder()\n",
    "label_encoder.classes_ = data[\"classes\"]\n",
    "\n",
    "print(\"Training shape:\", X_train.shape)\n",
    "print(\"Testing shape:\", X_test.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3307f9d3",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.model_selection import GroupShuffleSplit\n",
    "\n",
    "train_groups = groups[train_idx]\n",
    "\n",
    "splitter = GroupShuffleSplit(\n",
    "    n_splits=1,\n",
    "    test_size=0.2,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "train_sub_idx, val_idx = next(\n",
    "    splitter.split(\n",
    "        X_train,\n",
    "        y_train,\n",
    "        train_groups\n",
    "    )\n",
    ")\n",
    "\n",
    "X_train_final = X_train[train_sub_idx]\n",
    "y_train_final = y_train[train_sub_idx]\n",
    "\n",
    "X_val = X_train[val_idx]\n",
    "y_val = y_train[val_idx]\n",
    "\n",
    "print(\"Training:\", X_train_final.shape)\n",
    "print(\"Validation:\", X_val.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "bd14d703",
   "metadata": {},
   "outputs": [],
   "source": [
    "train_actors = set(train_groups[train_sub_idx])\n",
    "\n",
    "val_actors = set(train_groups[val_idx])\n",
    "\n",
    "test_actors = set(groups[test_idx])\n",
    "\n",
    "print(\"Training actors:\", sorted(train_actors))\n",
    "print(\"Validation actors:\", sorted(val_actors))\n",
    "print(\"Testing actors:\", sorted(test_actors))\n",
    "\n",
    "print(\"Train/Validation overlap:\", train_actors & val_actors)\n",
    "\n",
    "print(\"Train/Test overlap:\", train_actors & test_actors)\n",
    "\n",
    "print(\"Validation/Test overlap:\", val_actors & test_actors)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5d9727b5",
   "metadata": {},
   "outputs": [],
   "source": [
    "model = Sequential([\n",
    "    Input(shape=(40, 228, 1)),\n",
    "\n",
    "    Conv2D(\n",
    "        32,\n",
    "        3,\n",
    "        activation=\"relu\",\n",
    "        padding=\"same\"\n",
    "    ),\n",
    "\n",
    "    BatchNormalization(),\n",
    "\n",
    "    MaxPooling2D(2),\n",
    "\n",
    "    Conv2D(\n",
    "        64,\n",
    "        3,\n",
    "        activation=\"relu\",\n",
    "        padding=\"same\"\n",
    "    ),\n",
    "\n",
    "    BatchNormalization(),\n",
    "\n",
    "    MaxPooling2D(2),\n",
    "\n",
    "    Conv2D(\n",
    "        128,\n",
    "        3,\n",
    "        activation=\"relu\",\n",
    "        padding=\"same\"\n",
    "    ),\n",
    "\n",
    "    BatchNormalization(),\n",
    "\n",
    "    MaxPooling2D(2),\n",
    "\n",
    "    GlobalAveragePooling2D(),\n",
    "\n",
    "    Dense(64, activation=\"relu\"),\n",
    "\n",
    "    Dropout(0.4),\n",
    "\n",
    "    Dense(\n",
    "        len(label_encoder.classes_),\n",
    "        activation=\"softmax\"\n",
    "    )\n",
    "])\n",
    "\n",
    "model.compile(\n",
    "    optimizer=\"adam\",\n",
    "    loss=\"sparse_categorical_crossentropy\",\n",
    "    metrics=[\"accuracy\"]\n",
    ")\n",
    "\n",
    "model.summary()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e4174109",
   "metadata": {},
   "outputs": [],
   "source": [
    "from tensorflow.keras.callbacks import (\n",
    "    EarlyStopping,\n",
    "    ReduceLROnPlateau\n",
    ")\n",
    "\n",
    "callbacks = [\n",
    "    EarlyStopping(\n",
    "        monitor=\"val_loss\",\n",
    "        patience=6,\n",
    "        restore_best_weights=True\n",
    "    ),\n",
    "\n",
    "    ReduceLROnPlateau(\n",
    "        monitor=\"val_loss\",\n",
    "        factor=0.5,\n",
    "        patience=3,\n",
    "        min_lr=1e-6\n",
    "    )\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "55185dae",
   "metadata": {},
   "outputs": [],
   "source": [
    "history = model.fit(\n",
    "    X_train_final,\n",
    "    y_train_final,\n",
    "\n",
    "    validation_data=(X_val, y_val),\n",
    "\n",
    "    epochs=50,\n",
    "    batch_size=32,\n",
    "\n",
    "    callbacks=callbacks,\n",
    "\n",
    "    verbose=1\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "39cbc85f",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(10, 5))\n",
    "\n",
    "plt.plot(\n",
    "    history.history[\"accuracy\"],\n",
    "    label=\"Training Accuracy\"\n",
    ")\n",
    "\n",
    "plt.plot(\n",
    "    history.history[\"val_accuracy\"],\n",
    "    label=\"Validation Accuracy\"\n",
    ")\n",
    "\n",
    "plt.title(\"CNN Model Accuracy\")\n",
    "\n",
    "plt.xlabel(\"Epochs\")\n",
    "plt.ylabel(\"Accuracy\")\n",
    "\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "81dc0dc1",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(10, 5))\n",
    "\n",
    "plt.plot(\n",
    "    history.history[\"loss\"],\n",
    "    label=\"Training Loss\"\n",
    ")\n",
    "\n",
    "plt.plot(\n",
    "    history.history[\"val_loss\"],\n",
    "    label=\"Validation Loss\"\n",
    ")\n",
    "\n",
    "plt.title(\"CNN Model Loss\")\n",
    "\n",
    "plt.xlabel(\"Epochs\")\n",
    "plt.ylabel(\"Loss\")\n",
    "\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ffa99a77",
   "metadata": {},
   "outputs": [],
   "source": [
    "model.save(\"audio_emotion_cnn.keras\")\n",
    "import os\n",
    "os.makedirs(\"../models\", exist_ok=True)\n",
    "model.save(\"../models/audio_emotion_cnn.keras\")\n",
    "\n",
    "print(\"Model saved successfully!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "da7fdc4e",
   "metadata": {},
   "outputs": [],
   "source": [
     "# ==========================================\n",
     "# Model 2: Bi-Directional LSTM Architecture\n",
     "# ==========================================\n",
     "from tensorflow.keras.layers import Bidirectional, LSTM\n",
     "\n",
     "# Reshape feature dimensions for sequential modeling (N, time_steps, n_mfcc)\n",
     "X_train_sub_seq = X_train_final.squeeze(-1).transpose(0, 2, 1)\n",
     "X_val_seq = X_val.squeeze(-1).transpose(0, 2, 1)\n",
     "\n",
     "lstm_model = Sequential([\n",
     "    Input(shape=(228, 40)),\n",
     "    Bidirectional(LSTM(64, return_sequences=True)),\n",
     "    Dropout(0.3),\n",
     "    Bidirectional(LSTM(64)),\n",
     "    Dropout(0.3),\n",
     "    Dense(64, activation=\"relu\"),\n",
     "    Dropout(0.4),\n",
     "    Dense(len(label_encoder.classes_), activation=\"softmax\")\n",
     "])\n",
     "\n",
     "lstm_model.compile(\n",
     "    optimizer=\"adam\",\n",
     "    loss=\"sparse_categorical_crossentropy\",\n",
     "    metrics=[\"accuracy\"]\n",
     ")\n",
     "\n",
     "lstm_history = lstm_model.fit(\n",
     "    X_train_sub_seq,\n",
     "    y_train_final,\n",
     "    validation_data=(X_val_seq, y_val),\n",
     "    epochs=50,\n",
     "    batch_size=32,\n",
     "    callbacks=callbacks,\n",
     "    verbose=1\n",
     ")\n",
     "\n",
     "lstm_model.save(\"audio_emotion_lstm.keras\")\n",
     "lstm_model.save(\"../models/audio_emotion_lstm.keras\")\n",
     "print(\"LSTM Model saved successfully!\")\n",
     "    ]"
  }
 ],
